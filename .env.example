# Vector Database Environment Configuration
# Copy this file to .env and update with your values

# ============================================================================
# API Server Configuration
# ============================================================================

# Application Info
PROJECT_NAME="Vector DB API"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# Server Settings
HOST="0.0.0.0"
PORT=8000

# SDK Client Configuration
API_BASE_URL="http://localhost:8000"

# Environment (development or production)
ENVIRONMENT="development"

# CORS Settings
# Comma-separated list of allowed origins (use "*" for all origins in development)
BACKEND_CORS_ORIGINS="*"

# ============================================================================
# Third-Party API Keys
# ============================================================================

# Cohere API Key (required for examples)
# Get your key from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=""

# ============================================================================
# Optional: Other Embedding Providers
# ============================================================================

# OpenAI API Key (if using OpenAI embeddings)
# OPENAI_API_KEY=""

# Anthropic API Key (if using Anthropic embeddings)
# ANTHROPIC_API_KEY=""

# ============================================================================
# Database Configuration (Future Use)
# ============================================================================

# When you add persistent storage, configure here:
# DATABASE_URL="postgresql://user:password@localhost:5432/vectordb"
# REDIS_URL="redis://localhost:6379"

# ============================================================================
# Logging Configuration
# ============================================================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Enable debug mode
DEBUG=false
